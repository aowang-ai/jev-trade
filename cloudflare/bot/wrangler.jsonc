{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-trade-bot",
  "account_id": "a1d7542d06e5119c859e11e7755043c2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "MODEL": "mock",
    "DRY_RUN": "true",
    "RESTORATION_MODE": "true",
    "HL_TESTNET": "true",
    "HL_COINS": "BTC,ETH,SOL,DOGE,BNB",
    "TICK_MS": "2000",
    "PRICE_MS": "200",
    "PORT": "3000",
    "HISTORY_DATA_DIR": "data/history",
    "HISTORY_R2_BUCKET": "jev-trade-mig-archive",
    "HISTORY_AUTO_LOAD_R2_KEY": "mig1/runtime-history-bundle.json",
    "HISTORY_PERSIST_R2_KEY": "mig1/runtime-history-bundle.json"
  },
  "containers": [
    {
      "class_name": "JevBotContainer",
      "image": "../../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "JevBotContainer",
        "name": "JEV_BOT"
      }
    ]
  },
  "exports": {
    "JevBotContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "upload_source_maps": true
}
