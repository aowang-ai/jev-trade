# Base URL of the Jev Trade bot (no trailing slash).
# The app connects to $NEXT_PUBLIC_API_URL/events (SSE).
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:3000
# Cloudflare (set at build time before `bun run cf:deploy`):
# NEXT_PUBLIC_API_URL=https://jev-trade-bot.<your-workers-subdomain>.workers.dev
