# Comma list of Hyperliquid perps.
HL_COINS=BTC,ETH,SOL,DOGE,BNB
# true = testnet (default). Set false only for mainnet.
HL_TESTNET=true
HL_LEVERAGE=3
# Decision + requote cadence.
TICK_MS=500
# Margin cap per wallet. Quote notional per tick.
SLEEVE_USD=200
QUOTE_USD=40
QUOTE_INSIDE_TICKS=1
BANKROLL_USD=200
HORIZON_BLOCKS=100

# Live testnet: set PRIVATE_KEY for the first coin (BTC). Other coins read gitignored .wallets.json.
# DRY_RUN=true forces simulated quotes on every sleeve.
# Faucet: https://app.hyperliquid-testnet.xyz/drip (same address must have deposited on mainnet).
PRIVATE_KEY=
DRY_RUN=false

# mock | jev
MODEL=jev
# Vercel AI Gateway key. evaluate({ model: 'typesafe-ai/jev' }) reads AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
JEV_MODEL_ID=typesafe-ai/jev

# Bot SSE. Dashboard Next in web/ uses 3001.
PORT=3000
