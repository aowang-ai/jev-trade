# Comma list of Hyperliquid perps.
HL_COINS=BTC,ETH,SOL,DOGE,BNB
# true = testnet (default). Set false only for mainnet.
HL_TESTNET=true
# Decision + requote cadence. Jev picks leverage, open/close, and long/short.
TICK_MS=500
# Quote notional per tick. No sleeve or position cap.
QUOTE_USD=40
QUOTE_INSIDE_TICKS=1
BANKROLL_USD=200
HORIZON_BLOCKS=100

# Live testnet: set PRIVATE_KEY for the first coin (BTC).
# Other coins: gitignored .wallets.json locally, or WALLETS_JSON on Railway.
# WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}
# DRY_RUN=true forces simulated quotes on every sleeve.
# Faucet: https://app.hyperliquid-testnet.xyz/drip (same address must have deposited on mainnet).
PRIVATE_KEY=
DRY_RUN=false

# mock | jev
MODEL=jev
# Vercel AI Gateway key. evaluate({ model: 'typesafe-ai/jev' }) reads AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
JEV_MODEL_ID=typesafe-ai/jev

# Bot SSE. Dashboard Next in web/ uses 3001.
PORT=3000
